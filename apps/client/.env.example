# Frontend env vars must be prefixed with VITE_ to be exposed to the client.
# Leave empty to use the same-origin /api proxy in dev.
VITE_API_BASE_URL=

# ─── Firebase (Phone sign-up + temporary inbox Google access) ──────────────
# Get these from your Firebase project console → Project settings → Your apps
# If left empty, phone sign-up will show a "Firebase not configured" message.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Cloudflare Turnstile site key for the temporary inbox create action.
# Enable the Google provider in Firebase Authentication for this product.
VITE_TURNSTILE_SITE_KEY=
