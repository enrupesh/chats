{
  "name": "@veil/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "tsc -b && vite build",
    "build:android": "cross-env VITE_CAPACITOR=true tsc -b && cross-env VITE_CAPACITOR=true vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/build-og-image.mjs",
    "cap:sync": "pnpm build:android && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:icons": "node scripts/generate-android-icons.mjs",
    "cap:splash": "node scripts/generate-splash.mjs"
  },
  "dependencies": {
