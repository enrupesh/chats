<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Uses VeilChat brand colours. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/statusbar_color</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
        Launch theme shown while the Android 12+ SplashScreen is active.

        windowSplashScreenAnimatedIcon — points to the AnimatedVectorDrawable
            that draws the V-chevron path in, then fades the notification dot
            in (total ~900 ms). On Android < 12 this gracefully falls back to
            the static ic_launcher_foreground vector.

        windowSplashScreenIconBackgroundColor — the green circle behind the
            white V-chevron, matching the adaptive launcher icon background so
            the icon looks identical between the home-screen icon and the
            splash screen.

        windowSplashScreenAnimationDuration — tells the OS how long to run
            the AVD animation before allowing the splash to dismiss. Must be
            >= total animator duration in ic_splash_animated.xml (600+300=900).

        windowSplashScreenBackground — full-screen background behind the icon.
            Matches the app shell (#FCF5EB cream) so there is no colour flash
            when the WebView first paints.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
