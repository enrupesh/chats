<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths used by Capacitor and the app.

  external-path "." covers the root of external storage so that the
  Filesystem plugin can share URIs for files written to Downloads and
  other public external directories (needed on Android 9 and below).

  external-files-path covers app-specific external files (Android 10+).
  cache-path / external-cache-path cover temporary shares and previews.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Public external storage root (Downloads, Documents, etc.) -->
    <external-path name="external_files" path="." />

    <!-- App-specific external files -->
    <external-files-path name="external_app_files" path="." />

    <!-- App internal cache -->
    <cache-path name="cache_files" path="." />

    <!-- App external cache -->
    <external-cache-path name="external_cache_files" path="." />
</paths>